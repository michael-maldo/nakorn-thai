# VPS production: assumes PostgreSQL runs on the same VPS.
# Replace DB_PASSWORD with the password assigned to this database role.
# Spring Boot does not load this file automatically; see backend/README.md.
# Use literal quoted values. Do not add shell commands or variable substitutions.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://127.0.0.1:5432/nakorn_thai
DB_USERNAME=nakorn_app
DB_PASSWORD='REPLACE_WITH_PROD_DATABASE_PASSWORD'
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
MEDIA_BASE_URL=/media/

# Observability: enable trace export once Tempo/collector is available.
APP_ENV=prod
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8081
LOG_FILE=/var/log/nakorn-thai/backend.json.log
TRACING_EXPORT_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Bootstrap dashboard account; empty hash skips creation, not existing DB accounts.
# Generate with htpasswd -nBC 12 admin, copy the hash only, preserve single quotes.
MENU_ADMIN_USERNAME=admin
MENU_ADMIN_PASSWORD_HASH=''

# Pickup orders: enable only when FOH and kitchen staff are ready.
ONLINE_ORDERING_ENABLED=false
FOH_USERNAME=foh
FOH_PASSWORD_HASH=''
BOH_USERNAME=kitchen
BOH_PASSWORD_HASH=''

# JWT: production requires a persistent key from openssl rand -base64 32.
# A blank dev key is ephemeral: restarting invalidates access tokens.
JWT_SECRET_BASE64=''
JWT_COOKIE_SECURE=true

# Optional payment integrations. Enable only after configuring provider accounts.
PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=''
PAYPAL_CLIENT_SECRET=''
# Same-tab approval return; backend adds return/cancel markers before the hash.
PAYPAL_RETURN_URL='https://nakorn-thai.tech-labs.dev/#/order-confirmation'
# PayID is a manual bank transfer; ADMIN/FOH must verify actual receipt.
PAYID_ENABLED=false
PAYID_IDENTIFIER=''
PAYID_ACCOUNT_NAME=''

# Twilio Verify: SMS and email OTPs for order tracking recovery and reservation contacts.
# Email requires a SendGrid email integration on the Verify service.
VERIFY_SMS_ENABLED=false
VERIFY_EMAIL_ENABLED=false
TWILIO_ACCOUNT_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_VERIFY_SERVICE_SID=''

# Reservation confirmations (optional; failed jobs retry up to five times).
TWILIO_SMS_FROM=''
SMTP_HOST=''
SMTP_PORT=587
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_FROM=''
SMTP_STARTTLS=true
NOTIFICATION_POLL_MS=10000

# Dashboard credentials: Base64-encoded 32 random bytes (openssl rand -base64 32).
# Deployment-only; no default. Required once encrypted credentials are saved.
# Back up separately from PostgreSQL. All instances must use the same key.
NAKORN_CREDENTIAL_MASTER_KEY=
# Existing provider variables remain fallback until explicitly dashboard-managed.
# See docs/restaurant/admin-configuration.md for migration and rotation procedures.
ONLINE_RESERVATIONS_ENABLED=true
ORDER_PHONE_VERIFICATION_REQUIRED=true
RESERVATION_PHONE_VERIFICATION_REQUIRED=true
ORDER_SMS_NOTIFICATIONS_ENABLED=true
ORDER_EMAIL_NOTIFICATIONS_ENABLED=true
RESERVATION_SMS_NOTIFICATIONS_ENABLED=true
RESERVATION_EMAIL_NOTIFICATIONS_ENABLED=true
PAY_AT_RESTAURANT_ENABLED=true

# Independent notification providers (deployment selection; restart after changing).
NOTIFICATION_SMS_PROVIDER=twilio
NOTIFICATION_VERIFICATION_PROVIDER=twilio
# Vonage environment defaults, consumed through RuntimeConfiguration.
VONAGE_API_KEY=''
VONAGE_API_SECRET=''
VONAGE_SMS_FROM=''
VONAGE_VERIFY_BRAND=''
VONAGE_VERIFY_SMS_ENABLED=false
