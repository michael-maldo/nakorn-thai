<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/actionDescription" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/actionInput" android:importantForAutofill="no" android:hint="@string/label_pickup_minutes" android:saveEnabled="false" android:inputType="number" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/actionCheck" android:minHeight="48dp" android:saveEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/actionError" android:accessibilityLiveRegion="polite" android:paddingVertical="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton style="@style/DashboardPrimary" android:id="@+id/confirmAction" android:text="@string/label_confirm" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton style="@style/DashboardOutline" android:id="@+id/discardDraft" android:text="@string/label_discard_draft" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton style="@style/DashboardOutline" android:id="@+id/closeAction" android:text="@string/label_keep_draft_and_close" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
