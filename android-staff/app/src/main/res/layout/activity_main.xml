<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/windowContent" android:layout_width="match_parent" android:layout_height="match_parent">
<androidx.drawerlayout.widget.DrawerLayout android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/rootContent" android:orientation="vertical" android:background="@color/staff_board" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/dashboardTopBar" android:background="@color/dashboard_green" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:minHeight="64dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<ImageButton android:id="@+id/sidebarToggle" android:src="@drawable/ic_menu" app:tint="#FFFFFF" android:contentDescription="@string/dashboard_collapse" android:background="?attr/selectableItemBackgroundBorderless" android:layout_width="48dp" android:layout_height="48dp"/>
<ImageButton android:id="@+id/drawerToggle" android:src="@drawable/ic_menu" app:tint="#FFFFFF" android:contentDescription="@string/label_open_navigation" android:background="?attr/selectableItemBackgroundBorderless" android:layout_width="48dp" android:layout_height="48dp"/>
<ImageView android:src="@drawable/nakorn_logo" android:importantForAccessibility="no" android:layout_width="36dp" android:layout_height="36dp" android:scaleType="fitCenter"/>
<TextView android:text="@string/dashboard_brand" android:textColor="#FFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:paddingHorizontal="12dp" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<com.google.android.material.button.MaterialButton android:id="@+id/orderAlerts" style="@style/Widget.MaterialComponents.Button.TextButton" app:icon="@drawable/ic_dashboard_bell" app:iconTint="#FFFFFF" android:textColor="#FFFFFF" android:minWidth="48dp" android:minHeight="48dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/topIdentity" android:textColor="#FFFFFF" android:textSize="13sp" android:maxEms="16" android:maxLines="2" android:ellipsize="end" android:paddingHorizontal="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.core.widget.NestedScrollView android:id="@+id/sidebar" android:fillViewport="true" android:background="@color/staff_surface" android:layout_width="208dp" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/brand" style="@style/DashboardHeading" android:text="@string/dashboard_workspace" android:padding="8dp"/><com.google.android.material.button.MaterialButton android:id="@+id/sidebarOrders" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/orders" app:icon="@drawable/ic_orders"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sidebarReservations" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/reservations" app:icon="@drawable/ic_reservations"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sidebarTimekeeping" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/timekeeping_title" app:icon="@drawable/tk_clock"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sidebarAnalytics" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/analytics" app:icon="@drawable/ic_analytics"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sidebarPrinters" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/printers_title" app:icon="@drawable/ic_dashboard_printer"/>
<com.google.android.material.button.MaterialButton android:id="@+id/sidebarManage" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/manage" app:icon="@drawable/ic_dashboard_manage"/><TextView android:id="@+id/identityLabel" style="@style/DashboardMuted" android:padding="8dp"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
<androidx.fragment.app.FragmentContainerView android:id="@+id/navHost" android:name="androidx.navigation.fragment.NavHostFragment" app:defaultNavHost="true" app:navGraph="@navigation/staff_navigation" android:background="@color/staff_board" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
</LinearLayout>
<LinearLayout android:id="@+id/alertBar" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:background="@color/dashboard_pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
<TextView android:id="@+id/alertText" style="@style/DashboardText" android:accessibilityLiveRegion="polite" android:layout_width="0dp" android:layout_weight="1"/>
<com.google.android.material.button.MaterialButton android:id="@+id/acknowledge" style="@style/DashboardOutline" android:text="@string/label_acknowledge_alert"/>
</LinearLayout>
<TextView android:id="@+id/shellConnection" style="@style/DashboardMuted" android:textSize="12sp" android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
<View android:id="@+id/footerDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/staff_line" android:importantForAccessibility="no"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/staff_footer">
<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/footer" app:menu="@menu/footer" app:labelVisibilityMode="labeled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:background="@color/staff_footer" android:minHeight="72dp" app:elevation="0dp" app:itemIconTint="@color/staff_nav_foreground" app:itemTextColor="@color/staff_nav_foreground" app:itemIconSize="24dp" app:itemTextAppearanceActive="@style/TextAppearance.NakornStaff.FooterActive" app:itemTextAppearanceInactive="@style/TextAppearance.NakornStaff.FooterInactive" app:itemHorizontalTranslationEnabled="false"/>
</FrameLayout></LinearLayout>
<androidx.core.widget.NestedScrollView android:id="@+id/overlayNavigation" android:layout_gravity="start" android:fillViewport="true" android:background="@color/staff_surface" android:layout_width="264dp" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView style="@style/DashboardHeading" android:text="@string/dashboard_workspace" android:paddingVertical="16dp"/><com.google.android.material.button.MaterialButton android:id="@+id/overlayOrders" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/orders" app:icon="@drawable/ic_orders"/>
<com.google.android.material.button.MaterialButton android:id="@+id/overlayReservations" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/reservations" app:icon="@drawable/ic_reservations"/>
<com.google.android.material.button.MaterialButton android:id="@+id/overlayTimekeeping" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/timekeeping_title" app:icon="@drawable/tk_clock"/>
<com.google.android.material.button.MaterialButton android:id="@+id/overlayAnalytics" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/analytics" app:icon="@drawable/ic_analytics"/>
<com.google.android.material.button.MaterialButton android:id="@+id/overlayPrinters" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/printers_title" app:icon="@drawable/ic_dashboard_printer"/>
<com.google.android.material.button.MaterialButton android:id="@+id/overlayManage" style="@style/Widget.NakornStaff.Navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp" android:text="@string/manage" app:icon="@drawable/ic_dashboard_manage"/><TextView android:id="@+id/drawerIdentity" style="@style/DashboardMuted" android:padding="12dp"/></LinearLayout></androidx.core.widget.NestedScrollView></androidx.drawerlayout.widget.DrawerLayout></FrameLayout>