<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/shiftStaff" style="@style/TkCell" android:layout_weight="1.2"/>
<TextView android:id="@+id/shiftIn" style="@style/TkCell" android:layout_weight="1.6"/>
