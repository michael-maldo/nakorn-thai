<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="8dp" android:background="@drawable/board_column" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:minHeight="52dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/columnHeading" android:textSize="@dimen/column_heading_size" android:textStyle="bold" android:padding="0dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/columnCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="28dp" android:gravity="center" android:paddingHorizontal="6dp" android:textSize="14sp" android:textColor="@color/staff_accent" android:fontFamily="sans-serif-medium" android:background="@drawable/count_badge" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/orderList" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="8dp" android:scrollbars="vertical" />
        <TextView android:id="@+id/emptyColumn" android:gravity="center" android:padding="16dp" android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/staff_muted" />
    </FrameLayout>
</LinearLayout>
