<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/detailBody" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/detailNotice" android:accessibilityLiveRegion="polite" android:paddingVertical="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/actions" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
